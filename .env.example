# Database & Cache
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=idea_validator
POSTGRES_USER=idea_user
POSTGRES_PASSWORD=change_me_local_only
DATABASE_URL=postgresql+psycopg://idea_user:change_me_local_only@postgres:5432/idea_validator
REDIS_URL=redis://redis:6379/0
VECTOR_STORE_URL=http://qdrant:6333

# External API Keys (used ONLY by M5 Tool Layer)
GITHUB_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
PRODUCTHUNT_TOKEN=
HOSTED_LLM_API_KEY=
HOSTED_LLM_MODEL=gemini-2.0-flash

# Internal Service URLs (container/k8s service DNS names, never hardcode localhost)
GATEWAY_URL=http://gateway:8000
ORCHESTRATOR_URL=http://orchestrator:8000
TOOLS_URL=http://tools:8000
KB_URL=http://kb:8000
ANALYST_URL=http://analyst:8000
IDEATION_URL=http://ideation:8000
VALIDATORS_URL=http://validators:8000
SCORER_URL=http://scorer:8000
VERDICT_URL=http://verdict:8000
CRITIC_URL=http://critic:8000
AGENTOPS_URL=http://agentops:8000
AGENTOPS_TRACE_DIR=data/traces
MAX_PAGES_PER_RUN=25

# UI Runtime Config
VITE_API_BASE_URL=http://localhost:8000

# Auth & App Settings
JWT_SECRET=change_me_jwt_secret
CONFIG_DIR=./config
RUBRICS_DIR=./rubrics
ENVIRONMENT=development
LOG_LEVEL=INFO
