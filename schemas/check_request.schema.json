{
  "$defs": {
    "ClaimItem": {
      "additionalProperties": false,
      "description": "Single claim submitted to M12 POST /check.",
      "properties": {
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "claim_id",
        "text"
      ],
      "title": "ClaimItem",
      "type": "object"
    },
    "EvidenceItem": {
      "additionalProperties": false,
      "description": "Retrieved evidence snippet from M6 with traceable card citation.",
      "properties": {
        "evidence_id": {
          "description": "Format: <card_id>#c<chunk>",
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "card_id": {
          "minLength": 1,
          "title": "Card Id",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "string"
            }
          ],
          "title": "Retrieved At"
        }
      },
      "required": [
        "evidence_id",
        "card_id",
        "quote",
        "source",
        "url",
        "retrieved_at"
      ],
      "title": "EvidenceItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "M12 POST /check request.",
  "properties": {
    "claims": {
      "items": {
        "$ref": "#/$defs/ClaimItem"
      },
      "title": "Claims",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceItem"
      },
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "claims",
    "evidence"
  ],
  "title": "CheckRequest",
  "type": "object"
}
