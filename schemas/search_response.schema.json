{
  "$defs": {
    "EvidenceItem": {
      "additionalProperties": false,
      "description": "Retrieved evidence snippet from M6 with traceable card citation.",
      "properties": {
        "evidence_id": {
          "description": "Format: <card_id>#c<chunk>",
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "card_id": {
          "minLength": 1,
          "title": "Card Id",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "string"
            }
          ],
          "title": "Retrieved At"
        }
      },
      "required": [
        "evidence_id",
        "card_id",
        "quote",
        "source",
        "url",
        "retrieved_at"
      ],
      "title": "EvidenceItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "M6 POST /search response.",
  "properties": {
    "query": {
      "title": "Query",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/EvidenceItem"
      },
      "title": "Items",
      "type": "array"
    },
    "total_candidates": {
      "default": 0,
      "minimum": 0,
      "title": "Total Candidates",
      "type": "integer"
    }
  },
  "required": [
    "query",
    "items"
  ],
  "title": "SearchResponse",
  "type": "object"
}
